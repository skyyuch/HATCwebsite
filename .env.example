# --- Site ---
# Public base URL used for canonical URLs, hreflang, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payload CMS ---
# Long random string. Generate e.g. `openssl rand -base64 32`.
PAYLOAD_SECRET=
# PostgreSQL connection string. Admin (/admin) and CMS-backed content require this.
DATABASE_URI=postgres://user:password@localhost:5432/hatc

# --- Analytics (tool TBD) ---
# Tracking ID is read here and injected at runtime; never hard-code it in code.
NEXT_PUBLIC_ANALYTICS_ID=

# --- Contact fallback (used only until SiteSettings is filled in the CMS) ---
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_LIVECHAT=
# Open-account (online registration) URL behind every "Open account" button.
# Leave empty (and unset in the CMS) to fall back to the contact link above.
NEXT_PUBLIC_OPEN_ACCOUNT_URL=
# Demo-account application URL. Leave empty (and unset in the CMS) to hide the
# "apply for a demo account" buttons site-wide — no demo flow exists yet, so a
# link would be a dead end.
NEXT_PUBLIC_DEMO_ACCOUNT_URL=

# Member login destination (trading-terminal login page). Prefer the CMS field
# Site settings → 帳戶入口 → 會員登入連結. Empty = the header login link is hidden.
NEXT_PUBLIC_MEMBER_LOGIN_URL=

# --- Machine translation (CMS one-click pre-fill; SERVER-ONLY, never NEXT_PUBLIC_) ---
# Leave MT_API_KEY empty to disable: the "Auto-translate" button and /api/translate
# endpoint degrade gracefully and the site keeps working on i18n fallback.
# Engine: `llm` (default, OpenAI-compatible chat-completions) or `deepl`.
MT_PROVIDER=llm
# API key for the selected engine. Required to enable translation.
MT_API_KEY=
# --- LLM engine (MT_PROVIDER=llm) ---
# OpenAI-compatible base URL and model. Any OpenAI-compatible endpoint works.
#
# Option A — OpenAI (NOT available in Hong Kong):
#   MT_BASE_URL=https://api.openai.com/v1
#   MT_MODEL=gpt-4o-mini
#
# Option B — Google Gemini via its OpenAI-compatible endpoint (available in
# Hong Kong; used in production). Get a key at https://aistudio.google.com/apikey
# (enable billing on the linked Cloud project for higher rate limits — the free
# tier's daily quota is small for long articles):
#   MT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   MT_MODEL=gemini-3.6-flash
MT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MT_MODEL=gemini-3.6-flash
# --- DeepL engine (MT_PROVIDER=deepl) ---
# Free tier: https://api-free.deepl.com/v2 ; Pro: https://api.deepl.com/v2
MT_DEEPL_URL=https://api-free.deepl.com/v2

# --- MT5 live market quotes (SERVER-ONLY, never NEXT_PUBLIC_) ---
# Homepage ticker / price cards read the MT5 quote gateway through
# /api/market/quotes. The browser must NOT call the gateway directly: its CORS
# allow-list excludes this site and the response-crypt key below is a shared
# secret. Leave QUOTE_GATEWAY_URL empty to disable — the homepage then keeps
# showing its clearly-labelled sample numbers.
#   Production: https://node.hatcmarket.com
#   UAT:        https://node.666678910.com
QUOTE_GATEWAY_URL=
# Must match the gateway's QUOTE_HTTP_CRYPT_SECRET. Leave empty only if the
# gateway has QUOTE_HTTP_CRYPT_ENABLED=false (it answers in plain JSON then).
QUOTE_HTTP_CRYPT_SECRET=

# --- GitBook import (SERVER-ONLY, never NEXT_PUBLIC_) ---
# Used by scripts/seed-academy-from-gitbook.ts to import the owner's GitBook
# knowledge base into the Gold Academy (academy-articles). Get a token at
# https://app.gitbook.com (Developer settings); SPACE_ID is in the space URL.
# Leave empty if you are not importing from GitBook.
GITBOOK_API_TOKEN=
GITBOOK_SPACE_ID=

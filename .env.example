# ===========================================================================
# Local `.env` template — copy to `.env` and fill in.
# ===========================================================================
# This file is for SECRETS and machine-specific overrides. The per-environment
# public values (site URL, operational link fallbacks, quote gateway host) live
# in the committed `config/env/{local,uat,prd}.env` and are applied by
# `npm run dev` / `build:uat` / `build:prd` / `start:prd` etc.
#
# Precedence, highest first:
#   1. real environment variables on the host / CI
#   2. config/env/<environment>.secrets.env    ← git-ignored, PER environment
#   3. this `.env` (and `.env.local`)          ← you are here, machine-wide
#   4. config/env/<environment>.env            ← committed public defaults
#
# If one machine has to build SEVERAL environments, put each environment's
# secrets in its own `config/env/<name>.secrets.env` (copy
# `config/env/secrets.env.example`) instead of this file — `build:uat` /
# `build:prd` then pick the right ones up with no edits in between.
# See docs/DEPLOYMENT.md §2.3a.
#
# Everything below is optional: with no environment at all the site still
# builds and runs on its built-in three-locale copy and sample market data.
# See docs/DEPLOYMENT.md §2.
# ===========================================================================

# --- Site ---
# Public base URL used for canonical URLs, hreflang, sitemap and robots.
# Build-time only (it is baked into the static HTML), so it cannot be switched
# after `next build` — each environment must be built with its own value.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to `false` for any non-production deployment: `robots.txt` then disallows
# everything and every page emits a noindex. Build-time only.
SITE_INDEXABLE=false

# --- Payload CMS ---
# Long random string. Generate e.g. `openssl rand -base64 32`.
PAYLOAD_SECRET=
# MongoDB connection string. Admin (/admin) and CMS-backed content require this.
# The database name is `hatc-cms`. Leave empty to run the site on its built-in
# three-locale fallback copy (no /admin).
DATABASE_URI=mongodb://user:password@localhost:27017/hatc-cms?authSource=admin

# --- Analytics (tool TBD) ---
# Tracking ID is read here and injected at runtime; never hard-code it in code.
# Keeps the NEXT_PUBLIC_ prefix on purpose: a tracking ID is public by nature
# and the tag will run in the browser.
NEXT_PUBLIC_ANALYTICS_ID=

# --- Operational links (SERVER-ONLY; the CMS always wins) -------------------
# Fallback used only until `SiteSettings` is filled in at /admin. Read solely by
# the server-only `src/lib/siteSettings.ts`, so these are intentionally NOT
# `NEXT_PUBLIC_` (renamed 2026-10-12) — the prefix only pushed the phone, email
# and account URLs into every browser bundle for nothing.
# ⚠ Still effectively BUILD-TIME: the pages are SSG, so these are read during
# prerender and baked into the HTML. Changing them needs `rm -rf .next` + a
# rebuild. The only way to change a link without rebuilding is the CMS.
CONTACT_WHATSAPP=
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_LIVECHAT=
# Open-account (online registration) URL behind every "Open account" button.
# Leave empty (and unset in the CMS) to fall back to the contact link above.
OPEN_ACCOUNT_URL=
# Demo-account application URL. Leave empty (and unset in the CMS) to hide the
# "apply for a demo account" buttons site-wide — no demo flow exists yet, so a
# link would be a dead end.
DEMO_ACCOUNT_URL=
# Member login destination (trading-terminal login page). Prefer the CMS field
# Site settings → 帳戶入口 → 會員登入連結. Empty = the header login link is hidden.
MEMBER_LOGIN_URL=

# --- Machine translation (CMS one-click pre-fill; SERVER-ONLY, never NEXT_PUBLIC_) ---
# Leave MT_API_KEY empty to disable: the "Auto-translate" button and /api/translate
# endpoint degrade gracefully and the site keeps working on i18n fallback.
# Engine: `llm` (default, OpenAI-compatible chat-completions) or `deepl`.
MT_PROVIDER=llm
# API key for the selected engine. Required to enable translation.
MT_API_KEY=
# --- LLM engine (MT_PROVIDER=llm) ---
# OpenAI-compatible base URL and model. Any OpenAI-compatible endpoint works.
#
# Option A — OpenAI (NOT available in Hong Kong):
#   MT_BASE_URL=https://api.openai.com/v1
#   MT_MODEL=gpt-4o-mini
#
# Option B — Google Gemini via its OpenAI-compatible endpoint (available in
# Hong Kong; used in production). Get a key at https://aistudio.google.com/apikey
# (enable billing on the linked Cloud project for higher rate limits — the free
# tier's daily quota is small for long articles):
#   MT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   MT_MODEL=gemini-3.6-flash
MT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MT_MODEL=gemini-3.6-flash
# --- DeepL engine (MT_PROVIDER=deepl) ---
# Free tier: https://api-free.deepl.com/v2 ; Pro: https://api.deepl.com/v2
MT_DEEPL_URL=https://api-free.deepl.com/v2

# --- MT5 live market quotes (SERVER-ONLY, never NEXT_PUBLIC_) ---
# Homepage ticker / price cards read the MT5 quote gateway through
# /api/market/quotes. The browser must NOT call the gateway directly: its CORS
# allow-list excludes this site and the response-crypt key below is a shared
# secret. Leave QUOTE_GATEWAY_URL empty to disable — the homepage then keeps
# showing its clearly-labelled sample numbers.
#   Production: https://node.hatcmarket.com   (set by config/env/prd.env)
#   UAT:        https://node.666678910.com    (set by config/env/uat.env)
QUOTE_GATEWAY_URL=
# Must match the gateway's QUOTE_HTTP_CRYPT_SECRET. Leave empty only if the
# gateway has QUOTE_HTTP_CRYPT_ENABLED=false (it answers in plain JSON then).
# 🚩 Differs between production and UAT; never commit either value.
QUOTE_HTTP_CRYPT_SECRET=

# --- GitBook import (SERVER-ONLY, never NEXT_PUBLIC_) ---
# Used by scripts/seed-academy-from-gitbook.ts to import the owner's GitBook
# knowledge base into the Gold Academy (academy-articles). Get a token at
# https://app.gitbook.com (Developer settings); SPACE_ID is in the space URL.
# Leave empty if you are not importing from GitBook.
GITBOOK_API_TOKEN=
GITBOOK_SPACE_ID=

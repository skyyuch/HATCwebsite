# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
# 🚩 Must stay ignored. These hold credentials (PAYLOAD_SECRET, the MongoDB
# connection string with its password, the quote-gateway crypt secret). The
# GitHub remote is public, and git history cannot be un-published. Public
# per-environment values belong in the committed config/env/*.env instead,
# which `npm run env:check` scans for credential-like keys.
.env*
!.env.example

# Per-environment credentials, so one machine can build several environments
# without editing anything between builds (docs/DEPLOYMENT.md §2.3a).
# Same red line as above: these are secrets, they must never be committed.
config/env/*.secrets.env

# Payload media uploads
/media

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# archives (delivery snapshots, design reference bundles)
*.zip

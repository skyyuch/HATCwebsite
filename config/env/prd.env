# ===========================================================================
# Deployment environment: PRD (production, www.hatcmarket.com)
# ===========================================================================
# Loaded by `scripts/with-env.mjs` for `npm run build:prd` / `start:prd`.
# Host environment variables override every value here.
#
# 🚩 THIS FILE IS COMMITTED — PUBLIC VALUES ONLY.
#    PAYLOAD_SECRET, DATABASE_URI, QUOTE_HTTP_CRYPT_SECRET and MT_API_KEY are
#    set on the production host only. See docs/DEPLOYMENT.md §2.3.
#
#    Adding any of them here does not just leak a credential — `with-env.mjs`
#    rejects credential-like keys, so `npm run build:prd` and `npm run
#    env:check` (CI) both exit 1 and nothing builds at all. Put them in
#    `config/env/prd.secrets.env` instead — git-ignored, loaded automatically
#    by `build:prd` / `start:prd`, so one machine can keep every environment
#    configured and switch with the command alone:
#        cp config/env/secrets.env.example config/env/prd.secrets.env
#    On a server that only runs production, the host's own environment is
#    equally fine (and is the only option on a CI runner):
#        export DATABASE_URI='mongodb://<user>:<pass>@<host>:27017/hatc-cms?authSource=admin'
#        export PAYLOAD_SECRET="$(openssl rand -base64 32)"
#    See docs/DEPLOYMENT.md §2.3a.
#
# Every value below is an approved fact from docs/HATC_FACTS.md. Do not add a
# domain, phone number or URL that is not recorded there.
# ===========================================================================

# --- SEO (build-time: baked into the static HTML, cannot switch at runtime) ---
NEXT_PUBLIC_SITE_URL=https://www.hatcmarket.com
SITE_INDEXABLE=true

# --- Operational links (read at prerender; CMS "網站營運設定" always wins) ---
# These are only the fallback for a production host whose CMS has not been
# filled in yet — governance keeps the CMS as the editable source of truth
# (docs/DEPLOYMENT.md §4). A value saved in `/admin` always takes precedence,
# and that is the only path that updates a link without a rebuild: these env
# values are baked into the static HTML at build time.
CONTACT_WHATSAPP=
CONTACT_PHONE="(852) 2322 2888"
CONTACT_EMAIL=info@hatchk.com
CONTACT_LIVECHAT=
OPEN_ACCOUNT_URL="https://h5.hatcmarket.com/#/pages/auth/register/index"
# ⚠ Not supplied by the owner. Empty = the demo-account and member-login
# buttons are not rendered anywhere on the site. That is the designed
# behaviour, not a bug — do not point them at a placeholder page.
DEMO_ACCOUNT_URL=
MEMBER_LOGIN_URL=

# --- MT5 quote gateway (runtime) --------------------------------------------
# Production gateway. Requires the production QUOTE_HTTP_CRYPT_SECRET on the
# host (it is NOT the UAT secret). Until the back office whitelists products
# for the production guest trading group, the gateway answers 403 and the site
# keeps showing its clearly-labelled sample numbers — no code change needed
# once that is fixed (docs/DEPLOYMENT.md §5).
QUOTE_GATEWAY_URL=https://node.hatcmarket.com

# --- CMS one-click machine translation (runtime; public engine settings) -----
# The 「一鍵機器翻譯」button next to Save in /admin drafts the other two locales
# from 繁體中文. Only MT_API_KEY is a credential, so it lives in
# `config/env/<env>.secrets.env` (or the host environment) — empty key = the
# button is hidden and /api/translate answers 501, site unaffected.
# 🚩 These two MUST be set, not left to the code defaults: the defaults are
#    OpenAI (api.openai.com / gpt-4o-mini), which is unavailable in Hong Kong.
#    The owner's engine is Google Gemini via its OpenAI-compatible endpoint
#    (第四十輪); a Gemini key sent to the OpenAI default fails with 401/404.
MT_PROVIDER=llm
MT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MT_MODEL=gemini-3.6-flash

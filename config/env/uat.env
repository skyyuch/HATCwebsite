# ===========================================================================
# Deployment environment: UAT (staging / acceptance testing)
# ===========================================================================
# Loaded by `scripts/with-env.mjs` for `npm run build:uat` / `start:uat`.
# Host environment variables override every value here.
#
# 🚩 THIS FILE IS COMMITTED — PUBLIC VALUES ONLY.
#    PAYLOAD_SECRET, DATABASE_URI, QUOTE_HTTP_CRYPT_SECRET and MT_API_KEY are
#    set on the UAT host only. The gateway crypt secret differs between UAT and
#    production — do not reuse the production one. See docs/DEPLOYMENT.md §2.3.
#
#    Adding any of them here does not just leak a credential — `with-env.mjs`
#    rejects credential-like keys, so `npm run build:uat` and `npm run
#    env:check` (CI) both exit 1 and nothing builds at all. Put them in the
#    UAT host's environment instead:
#        export DATABASE_URI='mongodb://<user>:<pass>@<host>:27017/hatc-cms?authSource=admin'
#        export PAYLOAD_SECRET="$(openssl rand -base64 32)"
#    …or in a `.env` created by hand on that host (git-ignored, never committed).
#    UAT and production must not share a database or a password.
# ===========================================================================

# --- SEO (build-time: baked into the static HTML, cannot switch at runtime) ---
# Supplied by the dev team and confirmed by the owner 2026-10-13 (第六十三輪).
# Same domain family as the UAT quote gateway (node.666678910.com) and resolves
# to the same UAT host. Only ever used by `build:uat` — never let it reach a
# production build, and never show it in page content (UAT domains must not
# appear anywhere on the site; see platformVisuals.ts WEB_TERMINAL_HOST).
NEXT_PUBLIC_SITE_URL=https://www.666678910.com
# UAT must never be indexed: it would compete with the production site for the
# same content. `robots.txt` disallows everything and every page carries
# `noindex` while this is false.
SITE_INDEXABLE=false

# --- Operational links (read at prerender; CMS "網站營運設定" always wins) ---
# ⚠ Empty by owner decision (2026-10-12, 第六十二輪): HATC has no UAT
# equivalents of the open-account / login / customer-service destinations, and
# inventing one is a red line. Production domains are deliberately NOT reused
# here — a tester must not be able to register a real account from UAT.
# Empty = the demo / login buttons are not rendered and "open account" falls
# back to the contact link (or to the `/register` stub when there is none).
# Fill the UAT values in that environment's own `/admin` when they exist.
CONTACT_WHATSAPP=
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_LIVECHAT=
OPEN_ACCOUNT_URL=
DEMO_ACCOUNT_URL=
MEMBER_LOGIN_URL=

# --- MT5 quote gateway (runtime) --------------------------------------------
# UAT gateway. Requires the UAT QUOTE_HTTP_CRYPT_SECRET on the host; without it
# the site keeps showing its clearly-labelled sample numbers.
QUOTE_GATEWAY_URL=https://node.666678910.com

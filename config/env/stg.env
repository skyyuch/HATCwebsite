# ===========================================================================
# Deployment environment: STG (pre-launch preview of production)
# ===========================================================================
# Loaded by `scripts/with-env.mjs` for `npm run build:stg` / `start:stg`.
# Host environment variables override every value here.
#
# Why this exists (2026-10-14): the production build was deployed to
# web.hatcmarket.com while www.hatcmarket.com still serves the older site.
# Running `build:prd` there made the preview crawlable *and* pointed every
# canonical / sitemap URL at www.hatcmarket.com, a host that serves different
# content — a bad signal to search engines, and invisible on the page itself.
#
# STG = production in every respect except the two things that must not lie
# before launch: the site's own address and whether it may be indexed.
# At cut-over, switch that host back to `build:prd` / `start:prd` — nothing
# else changes.
#
# 🚩 2026-10-14: the cut-over happened. www.hatcmarket.com now serves this site
# on `build:prd`, and web.hatcmarket.com is being retired (owner decision), so
# NEXT_PUBLIC_SITE_URL below is deliberately EMPTY — a stale address here would
# point canonical / sitemap / og:image at a host that no longer resolves.
# Set it to the preview host's real address (here or as a host env var) the
# next time something needs a non-production preview.
#
# 🚩 THIS FILE IS COMMITTED — PUBLIC VALUES ONLY.
#    PAYLOAD_SECRET, DATABASE_URI, QUOTE_HTTP_CRYPT_SECRET and MT_API_KEY are
#    set on the host only, or in the git-ignored `config/env/stg.secrets.env`
#    (loaded automatically by build:stg / start:stg). `with-env.mjs` rejects
#    credential-like keys here, so adding one makes the build exit 1.
#    ⚠ A secret placed in `prd.secrets.env` is NOT loaded by `build:stg` —
#    the files are matched by environment name. See docs/DEPLOYMENT.md §2.3a.
# ===========================================================================

# --- SEO (build-time: baked into the static HTML, cannot switch at runtime) ---
# The address this deployment actually answers on. It must match the host in
# the browser, otherwise canonical and sitemap point at someone else's pages.
# Empty until there is a new preview host (see the note at the top of this file).
NEXT_PUBLIC_SITE_URL=
# A pre-launch preview must never be indexed: it would compete with the real
# site for the same content, on a domain that is going away.
SITE_INDEXABLE=false

# --- Operational links (read at prerender; CMS "網站營運設定" always wins) ---
# Identical to prd.env on purpose: this is a faithful preview of the production
# site, so the buttons must lead where they will lead after launch. (UAT is the
# environment that deliberately leaves these empty — a tester there must not be
# able to open a real account.)
CONTACT_WHATSAPP=
CONTACT_PHONE=(852) 2322 2888
CONTACT_EMAIL=info@hatchk.com
CONTACT_LIVECHAT=
OPEN_ACCOUNT_URL=https://h5.hatcmarket.com/#/pages/auth/register/index
# ⚠ Not supplied by the owner. Empty = the demo-account and member-login
# buttons are not rendered anywhere on the site. That is the designed
# behaviour, not a bug — do not point them at a placeholder page.
DEMO_ACCOUNT_URL=
MEMBER_LOGIN_URL=

# --- MT5 quote gateway (runtime) --------------------------------------------
# Production gateway, same as prd.env (this preview runs on the production
# machine). Requires the PRODUCTION QUOTE_HTTP_CRYPT_SECRET on the host — the
# UAT secret cannot decrypt this gateway's responses, and a mismatch shows up
# as "Cannot resolve a guest context" in /api/market/diagnostics (§5.1).
QUOTE_GATEWAY_URL=https://node.hatcmarket.com

# --- CMS one-click machine translation (runtime; public engine settings) -----
# The 「一鍵機器翻譯」button next to Save in /admin drafts the other two locales
# from 繁體中文. Only MT_API_KEY is a credential, so it lives in
# `config/env/<env>.secrets.env` (or the host environment) — empty key = the
# button is hidden and /api/translate answers 501, site unaffected.
# 🚩 These two MUST be set, not left to the code defaults: the defaults are
#    OpenAI (api.openai.com / gpt-4o-mini), which is unavailable in Hong Kong.
#    The owner's engine is Google Gemini via its OpenAI-compatible endpoint
#    (第四十輪); a Gemini key sent to the OpenAI default fails with 401/404.
MT_PROVIDER=llm
MT_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
MT_MODEL=gemini-3.6-flash

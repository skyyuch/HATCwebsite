# ===========================================================================
# Deployment environment: LOCAL (developer machine)
# ===========================================================================
# Loaded by `scripts/with-env.mjs` for `npm run dev` / `build:local` /
# `start:local`. Anything you set on the host, in `.env.local` or in `.env`
# wins over this file, so put your own machine's values there.
#
# 🚩 THIS FILE IS COMMITTED — PUBLIC VALUES ONLY.
#    No PAYLOAD_SECRET, no DATABASE_URI credentials, no gateway crypt secret,
#    no MT_API_KEY. Those live in your git-ignored `.env` only.
#    See docs/DEPLOYMENT.md §2.
# ===========================================================================

# --- SEO (build-time: baked into the static HTML, cannot switch at runtime) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Local builds must never be crawlable if they ever get exposed.
SITE_INDEXABLE=false

# --- Operational links (read at prerender; CMS "網站營運設定" always wins) ---
# Empty on purpose: fill them in `/admin`, or in your own `.env` to test a
# specific link without a database. Empty = the button is simply not rendered
# (demo account / member login) or falls back to the contact link.
CONTACT_WHATSAPP=
CONTACT_PHONE=
CONTACT_EMAIL=
CONTACT_LIVECHAT=
OPEN_ACCOUNT_URL=
DEMO_ACCOUNT_URL=
MEMBER_LOGIN_URL=

# --- MT5 quote gateway (runtime) --------------------------------------------
# Empty = homepage / `/trading` keep their clearly-labelled sample numbers.
# To develop against live quotes, put BOTH the URL and the matching
# QUOTE_HTTP_CRYPT_SECRET in your git-ignored `.env` (the secret differs per
# gateway environment and must never be committed).
QUOTE_GATEWAY_URL=

# ===========================================================================
# Template for config/env/<environment>.secrets.env
# ===========================================================================
# Copy this file once per environment you build on this machine:
#
#     cp config/env/secrets.env.example config/env/prd.secrets.env
#     cp config/env/secrets.env.example config/env/uat.secrets.env
#
# `npm run build:prd` / `start:prd` then loads `prd.secrets.env` automatically,
# `build:uat` / `start:uat` loads `uat.secrets.env`, and so on — so one machine
# can keep every environment configured and switch with the command alone,
# without editing a connection string between builds.
#
# Precedence (highest first):
#   1. variables already exported on the host / CI
#   2. config/env/<environment>.secrets.env   ← this file, per environment
#   3. the repo's own .env.local / .env       ← machine-wide
#   4. config/env/<environment>.env           ← committed, public values
#
# Layer 2 deliberately beats a machine-wide `.env`: a value written for this
# specific environment should win, the same way Next's own
# `.env.production.local` beats `.env.local`.
#
# 🚩 `config/env/*.secrets.env` is git-ignored and must stay that way — the
#    GitHub remote is public and git history cannot be un-published. Both
#    `npm run env:check` and every `build:*` / `start:*` refuse to run if git
#    has stopped ignoring these files.
#
# ⚠ Never point two environments at the same database, and never reuse a
#   password between them. The quote-gateway crypt secret also differs between
#   UAT and production.
#
# See docs/DEPLOYMENT.md §2.3a.
# ===========================================================================

# --- CMS ---
# The database must already exist / be reachable from this machine. Note that
# `next build` reads it too: page content is baked into static HTML at
# prerender, so switching databases needs `rm -rf .next` + a rebuild.
DATABASE_URI=mongodb://<user>:<password>@<host>:27017/hatc-cms?authSource=admin

# Signs /admin sessions. Generate one per environment:
#     openssl rand -base64 32
PAYLOAD_SECRET=

# --- Live market quotes (optional; empty = site shows sample data) ---
# Fetch the value from the gateway project's deploy/env/*.env. UAT and
# production use DIFFERENT secrets — do not copy one into the other.
QUOTE_HTTP_CRYPT_SECRET=

# --- CMS one-click machine translation (optional; empty = button disabled) ---
MT_API_KEY=
